[Unit]
Description=Project Cortex — Cerebro
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/cerebro
ExecStart=/home/YOUR_USERNAME/cerebro/venv/bin/python /home/YOUR_USERNAME/cerebro/cerebro.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
