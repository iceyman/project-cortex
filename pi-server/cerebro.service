[Unit]
Description=Cerebro AI Robot Server
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/cerebro
ExecStart=/home/YOUR_USERNAME/cerebro/venv/bin/python /home/YOUR_USERNAME/cerebro/cerebro.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
